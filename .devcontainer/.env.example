# Copy to .env and set your own identity; .env is gitignored. Neither value
# may be empty: git reads them directly and a blank one aborts every commit.
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# Linux hosts not at uid 1000: uncomment, set to `id -u`/`id -g`, rebuild.
# USER_UID=1000
# USER_GID=1000

# Authenticates `gh` and, through its credential helper, `git` inside the
# container. entrypoint.sh runs `gh auth setup-git` on start-up.
GH_TOKEN=<your GitHub token>
